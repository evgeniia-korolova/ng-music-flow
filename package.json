{
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "semantic-release": "^24.2.9"
  },
  "scripts": {
    "install-all": "npm install && npm install --prefix client && npm install --prefix api",
    "docker": "docker compose up -d",
    "dev": "concurrently --kill-others -n \"client,API\" -c \"cyan,magenta\" \"npm run start:client\" \"npm run start:api\"",
    "start:client": "npm run start --prefix client",
    "start:api": "npm run start:dev --prefix api",
    "start": "npm run docker && sleep 5 && npm run dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/src/**/*.{ts,html,scss}": [
      "npm run lint:fix --prefix client",
      "npx prettier --write"
    ],
    "api/src/**/*.ts": [
      "npm run lint:fix --prefix api",
      "npx prettier --write"
    ],
    "*.{json,md}": [
      "npx prettier --write"
    ]
  }
}
