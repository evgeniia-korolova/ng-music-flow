{
  "name": "ng-music-flow",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "semantic-release": "^24.2.9",
    "supabase": "^2.98.2"
  },
  "scripts": {
    "install-all": "npm install && npm install --prefix client && npm install --prefix api",
    "docker": "docker compose up -d",
    "dev": "concurrently --kill-others -n \"client,API\" -c \"cyan,magenta\" \"npm run start:client\" \"npm run start:api\"",
    "start:client": "npm run start --prefix client",
    "start:api": "npm run start:dev --prefix api",
    "start": "npm run docker && sleep 5 && npm run dev",
    "prepare": "husky",
    "ci-all": "npm ci && npm ci --prefix client && npm ci --prefix api",
    "lint-all": "npm run lint --prefix client && npm run lint --prefix api",
    "build-all": "npm run build --prefix client && npm run build --prefix api",
    "test:client": "npm run test --prefix client",
    "test:api": "npm run test --prefix api",
    "test-all": "cd client && npm run test && cd .. && cd api && npm run test"
  },
  "lint-staged": {
    "client/src/**/*.{ts,html}": [
      "npm run lint:fix --prefix client",
      "npm run format --prefix client"
    ],
    "api/src/**/*.ts": [
      "npm run lint --prefix api",
      "npm run format --prefix api"
    ],
    "*.{json,md}": [
      "npx prettier --write"
    ]
  }
}
